* text=auto

# Keep Unity YAML and source files stable across Windows and macOS.
*.asset text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.unity text eol=lf

# Generated/runtime assets are binary.
*.aar binary
*.apk binary
*.data binary
*.glb binary
*.onnx binary
