{
  "expo": {
    "name": "SoilSync",
    "slug": "soilsync",
    "version": "1.3.0",
    "scheme": "soilsync",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f1e3",
      "imageWidth": 578
    },
    "runtimeVersion": "1.3.0",
    "updates": {
      "url": "https://u.expo.dev/06666497-2fe3-412f-9dd3-c7c4d83a4f8c",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SoilSync needs photo access so you can upload crop images for AI checkups.",
          "cameraPermission": "SoilSync needs camera access so you can take crop photos for AI checkups."
        }
      ],
      "react-native-fast-tflite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SoilSync to use your location."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SoilSync to use Face ID for app lock."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "enforceContrast": false
        }
      ],
      "./plugins/withImmersiveMode"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.shijaydev.SoilSync",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f1e3"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB2g3be45V49YQqfJ7b1NF2Ho9aNxedpfg"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06666497-2fe3-412f-9dd3-c7c4d83a4f8c"
      }
    }
  }
}
